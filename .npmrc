# pnpm config for Expo compatibility
# Node v24 requires stricter module resolution; hoisting fixes symlink issues
node-linker=hoisted
shamefully-hoist=true
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*react*

# Prevents ESM/CJS dual-package hazard warnings
strict-peer-dependencies=false
