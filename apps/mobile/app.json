{
  "expo": {
    "name": "ComicReader",
    "slug": "comic-reader",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zuixinmanhua.reader"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      },
      "package": "com.zuixinmanhua.reader"
    },
    "plugins": [
      "expo-sqlite"
    ]
  }
}
